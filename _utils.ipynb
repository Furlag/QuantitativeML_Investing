   "source": [
    "import os\n",
    "\n",
    "# Export the current conda environment to environment.yml\n",
    "exit_code = os.system(\"conda env export > environment.yml\")\n",
    "\n",
    "if exit_code == 0:\n",
    "    print(\"environment.yml successfully created!\")\n",
    "else:\n",
    "    print(\"There was an error exporting the environment.\")\n"
   ]
  }
